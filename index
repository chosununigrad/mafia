<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>마피아 게임</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
  :root{
    --bg:#14151c; --panel:#1f2130; --panel2:#272a3d; --text:#eceef7; --muted:#9aa0b8;
    --accent:#e0b04a; --red:#e2554f; --blue:#5a8dee; --green:#4fbf7f; --purple:#a77de8; --line:#33374d;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Pretendard","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
    background:var(--bg);color:var(--text);min-height:100vh;transition:background .6s}
  body.ph-day{--bg:#2a2418;--panel:#3a3222;--panel2:#463c29;--line:#5a4d33}
  body.ph-vote{--bg:#2b1c1e;--panel:#3a2427;--panel2:#472c30;--line:#5c393d}
  body.ph-night{--bg:#0b0d1a;--panel:#151a30;--panel2:#1c2240;--line:#283058}
  button{font:inherit;cursor:pointer;border:0;border-radius:8px;padding:10px 14px;background:var(--accent);color:#1b1b1b;font-weight:700}
  button.ghost{background:transparent;color:var(--text);border:1px solid var(--line);font-weight:500}
  button:disabled{opacity:.4;cursor:not-allowed}
  input{font:inherit;padding:11px 12px;border-radius:8px;border:1px solid var(--line);background:var(--panel2);color:var(--text);width:100%}
  input:focus{outline:2px solid var(--accent);border-color:transparent}
  .hidden{display:none!important}

  /* Home */
  #home{max-width:420px;margin:0 auto;padding:60px 20px}
  #home h1{font-size:40px;margin:0 0 6px;text-align:center}
  #home .sub{color:var(--muted);text-align:center;margin-bottom:32px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:14px}
  .card label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
  .row{display:flex;gap:8px}
  .row input{flex:1}
  #homeErr{color:var(--red);text-align:center;min-height:22px;margin-top:8px}
  #homeStatus{color:var(--muted);text-align:center;font-size:14px}
  .rules{font-size:13px;color:var(--muted);line-height:1.7}
  .rules b{color:var(--text)}

  /* Room */
  #room{max-width:1100px;margin:0 auto;padding:14px;display:flex;flex-direction:column;height:100vh}
  header{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  #phase{font-size:20px;font-weight:800}
  #timer{font-size:28px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--accent);margin-left:auto}
  .code{background:var(--panel2);border:1px solid var(--line);padding:6px 10px;border-radius:8px;font-size:14px}
  .code b{letter-spacing:2px;color:var(--accent)}
  main{display:grid;grid-template-columns:320px 1fr;gap:12px;flex:1;min-height:0}
  aside{display:flex;flex-direction:column;gap:12px;min-height:0;overflow:auto}
  #roleCard{text-align:center}
  #roleCard .icon{font-size:46px}
  #roleCard .rname{font-size:22px;font-weight:800;margin:4px 0}
  #roleCard .rdesc{font-size:13px;color:var(--muted);line-height:1.5}
  #roleCard.dead{opacity:.6}
  .deadTag{display:inline-block;margin-top:8px;background:var(--red);color:#fff;border-radius:6px;padding:2px 8px;font-size:12px}
  #hint{font-size:14px;color:var(--accent);margin-bottom:8px;min-height:20px}
  #players{list-style:none;margin:0;padding:0}
  #players li{display:flex;align-items:center;gap:8px;padding:8px 6px;border-bottom:1px solid var(--line)}
  #players li:last-child{border-bottom:0}
  #players .pname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #players li.dead .pname{text-decoration:line-through;color:var(--muted)}
  #players li.off .pname{color:var(--muted)}
  .badge{font-size:11px;padding:2px 6px;border-radius:5px;background:var(--panel2);color:var(--muted);white-space:nowrap}
  .badge.mafia{background:var(--red);color:#fff}
  .badge.doctor{background:var(--green);color:#fff}
  .badge.police{background:var(--blue);color:#fff}
  .badge.citizen{background:#777;color:#fff}
  .badge.me{background:var(--accent);color:#222}
  .votes{font-weight:800;color:var(--red);min-width:28px;text-align:right}
  #players button{padding:5px 10px;font-size:13px}
  #players button.sel{background:var(--red);color:#fff}
  #hostBox button{width:100%;margin-top:6px}
  #hostBox .note{font-size:12px;color:var(--muted);margin-top:6px;text-align:center}

  .chat{display:flex;flex-direction:column;min-height:0}
  #log{flex:1;overflow-y:auto;padding:4px 2px;min-height:200px}
  .msg{padding:5px 8px;border-radius:8px;margin:3px 0;line-height:1.45;word-break:break-word;font-size:15px}
  .msg .who{font-weight:700;margin-right:6px}
  .msg.mine .who{color:var(--accent)}
  .msg.sys{background:var(--panel2);color:var(--text);font-size:14px;text-align:center}
  .msg.err{color:var(--red);text-align:center;font-size:13px}
  .msg.private{background:rgba(90,141,238,.18);border:1px solid var(--blue);font-size:14px}
  .msg.ch-mafia{background:rgba(226,85,79,.15)}
  .msg.ch-mafia .tag{color:var(--red)}
  .msg.ch-dead{background:rgba(167,125,232,.13);color:#cfc3e8}
  .msg.ch-dead .tag{color:var(--purple)}
  .tag{font-size:11px;font-weight:700;margin-right:4px}
  #chatForm{display:flex;gap:8px;margin-top:10px}
  #chatForm input{flex:1}
  #chanLabel{font-size:12px;color:var(--muted);margin-top:8px}

  @media (max-width:760px){
    #room{height:auto;min-height:100vh}
    main{grid-template-columns:1fr}
    #log{height:45vh;flex:none}
  }
</style>
</head>
<body>

<!-- ===== 시작 화면 ===== -->
<section id="home">
  <h1>🕵️ 마피아</h1>
  <div class="sub">닉네임만 정하고 바로 시작하세요</div>

  <div class="card">
    <label for="nick">닉네임</label>
    <input id="nick" maxlength="10" placeholder="최대 10자" autocomplete="off">
  </div>

  <div class="card">
    <button id="btnCreate" style="width:100%">새 방 만들기</button>
    <div style="text-align:center;color:var(--muted);margin:14px 0;font-size:13px">또는 친구 방에 참가</div>
    <div class="row">
      <input id="joinCode" maxlength="5" placeholder="방 코드 5자리" autocomplete="off" style="text-transform:uppercase">
      <button id="btnJoin">참가</button>
    </div>
  </div>
  <div id="homeStatus"></div>
  <div id="homeErr"></div>

  <div class="card rules">
    <b>게임 규칙</b><br>
    · 4~12명. 시작하면 역할이 무작위로 정해져요.<br>
    · <b>낮(2분)</b> 모두 채팅으로 토론하며 마피아를 추리해요.<br>
    · <b>저녁(30초)</b> 투표로 한 명을 처형해요. 동점이면 아무도 죽지 않아요.<br>
    · <b>밤(30초)</b> 마피아는 한 명을 지목하고(마피아끼리 비밀 채팅), 의사는 한 명을 살리고, 경찰은 한 명을 조사해요.<br>
    · 마피아가 모두 죽으면 <b>시민 승리</b>, 마피아 수가 나머지와 같아지면 <b>마피아 승리</b>.<br>
    · 죽은 사람은 죽은 사람끼리만 대화할 수 있어요.<br>
    · 마피아 수: 4~5명 1명 / 6~8명 2명 / 9명 이상 3명
  </div>
</section>

<!-- ===== 게임 화면 ===== -->
<section id="room" class="hidden">
  <header>
    <div id="phase">대기실</div>
    <div class="code">방 코드 <b id="code">-----</b></div>
    <button class="ghost" id="btnCopy" style="padding:6px 10px;font-size:13px">코드 복사</button>
    <div id="timer"></div>
    <button class="ghost" id="btnLeave" style="padding:6px 10px;font-size:13px">나가기</button>
  </header>
  <main>
    <aside>
      <div class="card" id="roleCard"></div>
      <div class="card">
        <div id="hint"></div>
        <ul id="players"></ul>
        <div id="hostBox"></div>
      </div>
    </aside>
    <div class="card chat">
      <div id="log"></div>
      <div id="chanLabel"></div>
      <form id="chatForm" autocomplete="off">
        <input id="chatInput" maxlength="200" placeholder="메시지 입력">
        <button type="submit">전송</button>
      </form>
    </div>
  </main>
</section>

<script>
/* ================= 설정 ================= */
const PREFIX = 'mafia-game-kr-v1-';
const DUR = { day: 120, vote: 30, night: 30 };      // 초
const SPEED = parseFloat(new URLSearchParams(location.search).get('speed')) || 1; // 테스트용 배속
const MAX_PLAYERS = 12;

const ROLE = {
  mafia:   { name:'마피아', icon:'🔪', desc:'밤마다 한 명을 골라 제거하세요. 밤에는 마피아끼리만 비밀 채팅을 할 수 있어요. 정체를 숨기세요!' },
  doctor:  { name:'의사',   icon:'💉', desc:'밤마다 한 명을 치료하세요. 마피아가 그 사람을 노리면 살려낼 수 있어요. 자신도 치료할 수 있어요.' },
  police:  { name:'경찰',   icon:'🔍', desc:'밤마다 한 명을 조사해 마피아인지 바로 알 수 있어요. 결과는 나만 볼 수 있어요.' },
  citizen: { name:'시민',   icon:'👤', desc:'특별한 능력은 없어요. 낮 토론과 투표로 마피아를 찾아내세요!' }
};

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

let peer = null, myId = null, isHost = false, hostConn = null, roomCode = '', myName = '';
let S = null;          // 서버(방장)에서 받은 최신 상태
let localEnd = 0;      // 현재 단계 종료 시각(로컬 기준)
let leaving = false;

/* ================= 시작 화면 ================= */
const qsRoom = new URLSearchParams(location.search).get('room');
if (qsRoom) $('#joinCode').value = qsRoom.toUpperCase();
try { $('#nick').value = localStorage.getItem('mafia_nick') || ''; } catch(e){}

function homeErr(t){ $('#homeErr').textContent = t || ''; }
function homeStatus(t){ $('#homeStatus').textContent = t || ''; }
function setHomeBusy(b){ $('#btnCreate').disabled = b; $('#btnJoin').disabled = b; }

function readNick(){
  const n = $('#nick').value.trim().slice(0,10);
  if (!n) { homeErr('닉네임을 입력해 주세요.'); $('#nick').focus(); return null; }
  try { localStorage.setItem('mafia_nick', n); } catch(e){}
  return n;
}
function checkLib(){
  if (typeof Peer === 'undefined') { homeErr('통신 라이브러리를 불러오지 못했어요. 인터넷 연결을 확인해 주세요.'); return false; }
  return true;
}
function genCode(){
  const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = '';
  for (let i=0;i<5;i++) s += c[Math.floor(Math.random()*c.length)];
  return s;
}

$('#btnCreate').onclick = () => {
  homeErr(); const n = readNick(); if (!n || !checkLib()) return;
  myName = n; isHost = true; setHomeBusy(true); homeStatus('방을 만드는 중...');
  createHostPeer();
};
function createHostPeer(tries = 0){
  const code = genCode();
  peer = new Peer(PREFIX + code, { debug: 0 });
  peer.on('open', id => {
    myId = id; roomCode = code;
    H.players = [{ id, name: myName, role:null, alive:true, online:true }];
    enterRoom();
    addSys(`방이 만들어졌어요. 친구들에게 방 코드 [${code}]를 알려주세요.`);
    broadcastState();
  });
  peer.on('connection', hostOnConn);
  peer.on('error', err => {
    if (err.type === 'unavailable-id' && tries < 5) { peer.destroy(); createHostPeer(tries+1); return; }
    if (!S) { setHomeBusy(false); homeStatus(); homeErr('연결 오류: ' + (err.type || err.message)); }
    else addSys('연결 오류: ' + (err.type || err.message), 'err');
  });
  peer.on('disconnected', () => { if (!leaving && peer && !peer.destroyed) peer.reconnect(); });
}

$('#btnJoin').onclick = () => {
  homeErr(); const n = readNick(); if (!n || !checkLib()) return;
  const code = $('#joinCode').value.trim().toUpperCase();
  if (code.length !== 5) { homeErr('방 코드 5자리를 입력해 주세요.'); return; }
  myName = n; isHost = false; setHomeBusy(true); homeStatus('방에 접속하는 중...');
  peer = new Peer({ debug: 0 });
  peer.on('open', id => {
    myId = id;
    hostConn = peer.connect(PREFIX + code, { reliable: true });
    hostConn.on('open', () => hostConn.send({ type:'join', name: myName }));
    hostConn.on('data', recv);
    hostConn.on('close', () => {
      if (leaving) return;
      if (S) { addSys('방장과의 연결이 끊어졌어요. 게임을 계속할 수 없어요.', 'err'); $('#chatInput').disabled = true; }
      else { setHomeBusy(false); homeStatus(); homeErr('방에 접속하지 못했어요.'); }
    });
  });
  peer.on('error', err => {
    if (!S) {
      setHomeBusy(false); homeStatus();
      homeErr(err.type === 'peer-unavailable' ? '방을 찾을 수 없어요. 코드를 확인해 주세요.' : '연결 오류: ' + (err.type || err.message));
    } else addSys('연결 오류: ' + (err.type || err.message), 'err');
  });
};
$('#nick').addEventListener('keydown', e => { if (e.key === 'Enter') ($('#joinCode').value.trim() ? $('#btnJoin') : $('#btnCreate')).click(); });
$('#joinCode').addEventListener('keydown', e => { if (e.key === 'Enter') $('#btnJoin').click(); });

function enterRoom(){
  $('#home').classList.add('hidden');
  $('#room').classList.remove('hidden');
  $('#code').textContent = roomCode;
  $('#log').innerHTML = '';
}

$('#btnCopy').onclick = () => {
  const t = roomCode;
  (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(
    () => addSys('방 코드를 복사했어요.'), () => addSys('방 코드: ' + t));
};
$('#btnLeave').onclick = () => {
  if (S && S.phase !== 'lobby' && S.phase !== 'end' && !confirm('게임 중에 나가면 사망 처리돼요. 나갈까요?')) return;
  if (isHost && !confirm('방장이 나가면 방이 사라져요. 나갈까요?')) return;
  leaving = true; try { peer && peer.destroy(); } catch(e){}
  location.href = location.pathname;
};

/* ================= 통신 ================= */
function send(m){
  if (isHost) hostHandle(myId, m);
  else if (hostConn && hostConn.open) hostConn.send(m);
}

/* ================= 클라이언트: 메시지 수신 ================= */
function recv(m){
  switch (m.type) {
    case 'welcome': roomCode = m.code; myName = m.name; enterRoom(); break;
    case 'state':
      S = m; localEnd = m.remaining ? Date.now() + m.remaining : 0; render(); break;
    case 'chat': addChat(m); break;
    case 'sys': addSys(m.text, m.kind); break;
    case 'error':
      if (m.fatal && !S) { setHomeBusy(false); homeStatus(); homeErr(m.text); leaving = true; peer && peer.destroy(); }
      else addSys(m.text, 'err');
      break;
  }
}

function addChat(m){
  const div = document.createElement('div');
  div.className = 'msg ch-' + m.ch + (m.fromId === myId ? ' mine' : '');
  const tag = m.ch === 'mafia' ? '<span class="tag">[마피아]</span>' : m.ch === 'dead' ? '<span class="tag">[사망자]</span>' : '';
  div.innerHTML = `${tag}<span class="who">${esc(m.from)}</span>${esc(m.text)}`;
  pushLog(div);
}
function addSys(text, kind){
  const div = document.createElement('div');
  div.className = 'msg ' + (kind === 'err' ? 'err' : kind === 'private' ? 'private' : 'sys');
  div.textContent = text;
  pushLog(div);
}
function pushLog(div){
  const log = $('#log');
  const atBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 60;
  log.appendChild(div);
  if (atBottom || div.classList.contains('mine')) log.scrollTop = log.scrollHeight;
}

$('#chatForm').addEventListener('submit', e => {
  e.preventDefault();
  const t = $('#chatInput').value.trim();
  if (!t) return;
  send({ type:'chat', text: t });
  $('#chatInput').value = '';
});

/* ================= 클라이언트: 화면 그리기 ================= */
function render(){
  const s = S; if (!s) return;
  document.body.className = 'ph-' + s.phase;
  $('#code').textContent = s.code;

  const PH = { lobby:'🏠 대기실', day:`☀️ ${s.day}일차 낮`, vote:`🌆 ${s.day}일차 저녁 · 투표`, night:`🌙 ${s.day}일차 밤`, end:'🏁 게임 종료' };
  $('#phase').textContent = PH[s.phase] || '';

  // 역할 카드
  const rc = $('#roleCard');
  if (s.myRole) {
    const r = ROLE[s.myRole];
    const mates = s.myRole === 'mafia' ? s.players.filter(p => p.role === 'mafia' && p.id !== s.me).map(p => p.name) : [];
    rc.className = 'card' + (s.alive ? '' : ' dead');
    rc.innerHTML = `<div class="icon">${r.icon}</div><div style="font-size:12px;color:var(--muted)">나의 역할</div>
      <div class="rname">${r.name}</div><div class="rdesc">${r.desc}</div>
      ${mates.length ? `<div class="rdesc" style="margin-top:8px;color:var(--red)">동료 마피아: ${esc(mates.join(', '))}</div>` : ''}
      ${s.alive ? '' : '<div class="deadTag">사망</div>'}
      ${s.phase === 'end' ? `<div class="rname" style="margin-top:10px;color:var(--accent)">${s.winner === 'mafia' ? '🔪 마피아 승리' : '🎉 시민 승리'}</div>` : ''}`;
  } else {
    rc.className = 'card';
    const n = s.players.length;
    rc.innerHTML = `<div class="icon">🎭</div><div class="rname">게임 대기 중</div>
      <div class="rdesc">현재 ${n}명 참가 중 (최소 4명)<br>방장이 시작하면 역할이 무작위로 정해져요.</div>`;
  }

  // 안내 문구
  let hint = '';
  if (s.phase === 'lobby') hint = isHost ? '4명 이상 모이면 게임을 시작하세요.' : '방장이 게임을 시작할 때까지 기다려 주세요.';
  else if (s.phase === 'end') hint = '모든 역할이 공개되었어요.';
  else if (!s.alive) hint = '👻 당신은 죽었어요. 게임을 지켜보세요.';
  else if (s.phase === 'day') hint = '토론하며 마피아를 추리하세요.';
  else if (s.phase === 'vote') hint = s.myVote ? '투표 완료 (다시 누르면 취소)' : '처형할 사람에게 투표하세요.';
  else if (s.phase === 'night') {
    hint = { mafia:'제거할 사람을 지목하세요.', doctor:'치료할 사람을 선택하세요.', police: s.myAction ? '오늘 밤 조사를 마쳤어요.' : '조사할 사람을 선택하세요.', citizen:'밤이 지나가길 기다리세요...' }[s.myRole];
  }
  $('#hint').textContent = hint;

  // 플레이어 목록
  $('#players').innerHTML = s.players.map(q => {
    const tags = [];
    if (q.id === s.me) tags.push('<span class="badge me">나</span>');
    if (q.id === s.hostId) tags.push('<span class="badge">방장</span>');
    if (q.role && (q.id !== s.me || s.phase === 'end')) tags.push(`<span class="badge ${q.role}">${ROLE[q.role].name}</span>`);
    if (!q.online) tags.push('<span class="badge">나감</span>');
    else if (!q.alive) tags.push('<span class="badge">사망</span>');

    let btn = '';
    if (s.alive && q.alive) {
      if (s.phase === 'vote' && q.id !== s.me) {
        btn = `<button data-act="vote" data-id="${q.id}" class="${s.myVote === q.id ? 'sel' : ''}">${s.myVote === q.id ? '투표함' : '투표'}</button>`;
      } else if (s.phase === 'night') {
        if (s.myRole === 'mafia' && q.role !== 'mafia')
          btn = `<button data-act="act" data-id="${q.id}" class="${s.myAction === q.id ? 'sel' : ''}">${s.myAction === q.id ? '지목됨' : '지목'}</button>`;
        else if (s.myRole === 'doctor')
          btn = `<button data-act="act" data-id="${q.id}" class="${s.myAction === q.id ? 'sel' : ''}">${s.myAction === q.id ? '치료 중' : '치료'}</button>`;
        else if (s.myRole === 'police' && q.id !== s.me)
          btn = s.myAction ? (s.myAction === q.id ? '<button class="sel" disabled>조사함</button>' : '')
                           : `<button data-act="act" data-id="${q.id}">조사</button>`;
      }
    }
    const votes = s.phase === 'vote' && q.votes ? `<span class="votes">${q.votes}표</span>` : '';
    return `<li class="${q.alive ? '' : 'dead'} ${q.online ? '' : 'off'}">
      <span class="pname">${esc(q.name)}</span>${tags.join('')}${votes}${btn}</li>`;
  }).join('');

  // 방장 버튼
  let hb = '';
  if (isHost) {
    if (s.phase === 'lobby') {
      const n = s.players.length;
      hb = `<button data-act="start" ${n < 4 ? 'disabled' : ''}>게임 시작 (${n}명)</button>`;
    } else if (s.phase === 'day') hb = `<button class="ghost" data-act="skip">토론 끝내고 바로 투표</button>`;
    else if (s.phase === 'end') hb = `<button data-act="restart">대기실로 돌아가기 (다시 하기)</button>`;
    if (s.phase !== 'lobby' && s.phase !== 'end') hb += '<div class="note">방장은 창을 닫거나 다른 탭에 오래 두지 마세요.</div>';
  }
  $('#hostBox').innerHTML = hb;

  // 채팅 채널
  let label = '전체 채팅', can = true;
  if (s.phase === 'lobby' || s.phase === 'end') label = '전체 채팅';
  else if (!s.alive) label = '👻 사망자 채팅 (죽은 사람끼리만 보여요)';
  else if (s.phase === 'night') {
    if (s.myRole === 'mafia') label = '🔪 마피아 채팅 (마피아끼리만 보여요)';
    else { label = '🌙 밤에는 대화할 수 없어요'; can = false; }
  }
  $('#chanLabel').textContent = label;
  $('#chatInput').disabled = !can;
  $('#chatInput').placeholder = can ? '메시지 입력' : '밤에는 조용히...';
}

// 버튼 클릭(이벤트 위임)
document.addEventListener('click', e => {
  const b = e.target.closest('button[data-act]'); if (!b || b.disabled) return;
  const a = b.dataset.act, id = b.dataset.id;
  if (a === 'vote') send({ type:'vote', target: S.myVote === id ? null : id });
  else if (a === 'act') send({ type:'act', target: id });
  else if (a === 'start') send({ type:'start' });
  else if (a === 'skip') send({ type:'skip' });
  else if (a === 'restart') send({ type:'restart' });
});

// 타이머 표시
setInterval(() => {
  if (!S) return;
  if (!localEnd || S.phase === 'lobby' || S.phase === 'end') { $('#timer').textContent = ''; return; }
  const r = Math.max(0, Math.ceil((localEnd - Date.now()) / 1000));
  $('#timer').textContent = `${Math.floor(r/60)}:${String(r%60).padStart(2,'0')}`;
}, 250);

/* ================= 방장(호스트): 게임 진행 ================= */
const H = { players: [], phase:'lobby', day:0, endAt:0, votes:{}, night:{}, timer:null, winner:null };
const conns = {};

function hostOnConn(conn){
  conn.on('data', d => hostHandle(conn.peer, d, conn));
  conn.on('close', () => hostLeave(conn.peer));
  conn.on('error', () => {});
}

function deliver(pid, m){
  if (pid === myId) { recv(m); return; }
  const c = conns[pid];
  if (c && c.open) { try { c.send(m); } catch(e){} }
}
function toWhere(fn, m){ H.players.forEach(p => { if (p.online && fn(p)) deliver(p.id, m); }); }
function toAll(m){ toWhere(() => true, m); }
function sysAll(text){ toAll({ type:'sys', text }); }
const P = id => H.players.find(p => p.id === id);
const inGame = () => ['day','vote','night'].includes(H.phase);

function view(p){
  const reveal = H.phase === 'end';
  const counts = {};
  if (H.phase === 'vote') Object.values(H.votes).forEach(t => counts[t] = (counts[t]||0) + 1);
  let myAction = null;
  if (H.phase === 'night' && p.role && p.role !== 'citizen') myAction = H.night[p.role] || null;
  return {
    type:'state', phase:H.phase, day:H.day, remaining: H.endAt ? Math.max(0, H.endAt - Date.now()) : 0,
    hostId: myId, code: roomCode, me: p.id, myRole: p.role, alive: p.alive,
    myVote: H.votes[p.id] || null, myAction, winner: H.winner,
    players: H.players.map(q => ({
      id:q.id, name:q.name, alive:q.alive, online:q.online, votes: counts[q.id] || 0,
      role: (reveal || q.id === p.id || (p.role === 'mafia' && q.role === 'mafia')) ? q.role : null
    }))
  };
}
function broadcastState(){ H.players.forEach(p => { if (p.online) deliver(p.id, view(p)); }); }

function setPhase(ph, sec, next){
  H.phase = ph;
  clearTimeout(H.timer);
  const ms = sec * 1000 * SPEED;
  H.endAt = Date.now() + ms;
  H.timer = setTimeout(next, ms);
  broadcastState();
}
function hurry(next){            // 모두 행동을 마쳤으면 3초 뒤 진행
  clearTimeout(H.timer);
  const ms = Math.min(3000, H.endAt - Date.now());
  H.endAt = Date.now() + Math.max(0, ms);
  H.timer = setTimeout(next, Math.max(0, ms));
}

function hostHandle(pid, m, conn){
  if (!m || typeof m !== 'object') return;

  if (m.type === 'join') {
    if (!conn) return;
    if (H.phase !== 'lobby') { conn.send({ type:'error', text:'이미 게임이 진행 중이에요. 다음 판에 참가해 주세요.', fatal:true }); setTimeout(() => conn.close(), 800); return; }
    if (H.players.length >= MAX_PLAYERS) { conn.send({ type:'error', text:'방이 가득 찼어요 (최대 12명).', fatal:true }); setTimeout(() => conn.close(), 800); return; }
    if (P(pid)) return;
    conns[pid] = conn;
    const base = String(m.name || '').trim().slice(0,10) || '익명';
    let name = base, i = 2;
    while (H.players.some(p => p.name === name)) name = base + (i++);
    H.players.push({ id:pid, name, role:null, alive:true, online:true });
    conn.send({ type:'welcome', code: roomCode, name });
    sysAll(`${name}님이 입장했어요.`);
    broadcastState();
    return;
  }

  const p = P(pid); if (!p) return;

  switch (m.type) {
    case 'chat': {
      const text = String(m.text || '').trim().slice(0,200); if (!text) return;
      const msg = { type:'chat', from:p.name, fromId:p.id, text, ch:'all' };
      if (!inGame()) return toAll(msg);
      if (!p.alive) return toWhere(q => !q.alive, { ...msg, ch:'dead' });
      if (H.phase === 'night') {
        if (p.role === 'mafia') return toWhere(q => q.role === 'mafia', { ...msg, ch:'mafia' });
        return deliver(pid, { type:'error', text:'밤에는 마피아만 대화할 수 있어요.' });
      }
      return toAll(msg);
    }
    case 'start': {
      if (pid !== myId || H.phase !== 'lobby') return;
      H.players = H.players.filter(q => q.online);
      const n = H.players.length;
      if (n < 4) return deliver(pid, { type:'error', text:'최소 4명이 필요해요.' });
      const k = n >= 9 ? 3 : n >= 6 ? 2 : 1;
      const roles = [...Array(k).fill('mafia'), 'doctor', 'police'];
      while (roles.length < n) roles.push('citizen');
      for (let i = roles.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i+1)); [roles[i], roles[j]] = [roles[j], roles[i]]; }
      H.players.forEach((q, i) => { q.role = roles[i]; q.alive = true; });
      H.day = 1; H.winner = null; H.votes = {};
      sysAll(`🎭 게임 시작! 마피아 ${k}명 · 의사 1명 · 경찰 1명 · 시민 ${n-k-2}명. 왼쪽에서 내 역할을 확인하세요.`);
      startDay();
      return;
    }
    case 'skip':
      if (pid === myId && H.phase === 'day') startVote();
      return;
    case 'vote': {
      if (H.phase !== 'vote' || !p.alive) return;
      if (m.target === null) delete H.votes[pid];
      else {
        const t = P(m.target);
        if (!t || !t.alive || t.id === pid) return;
        H.votes[pid] = t.id;
      }
      broadcastState();
      if (H.players.filter(q => q.alive).every(q => H.votes[q.id])) { hurry(resolveVote); broadcastState(); }
      return;
    }
    case 'act': {
      if (H.phase !== 'night' || !p.alive) return;
      const t = P(m.target); if (!t || !t.alive) return;
      if (p.role === 'mafia') {
        if (t.role === 'mafia') return;
        H.night.mafia = t.id;
        toWhere(q => q.role === 'mafia', { type:'sys', text:`🔪 ${p.name}님이 ${t.name}님을 지목했어요.`, kind:'private' });
      } else if (p.role === 'doctor') {
        H.night.doctor = t.id;
      } else if (p.role === 'police') {
        if (H.night.police || t.id === pid) return;
        H.night.police = t.id;
        deliver(pid, { type:'sys', kind:'private',
          text: t.role === 'mafia' ? `🔍 조사 결과: ${t.name}님은 마피아입니다!` : `🔍 조사 결과: ${t.name}님은 마피아가 아닙니다.` });
      } else return;
      broadcastState();
      checkNightDone();
      return;
    }
    case 'restart': {
      if (pid !== myId || H.phase !== 'end') return;
      H.players = H.players.filter(q => q.online);
      H.players.forEach(q => { q.role = null; q.alive = true; });
      H.phase = 'lobby'; H.day = 0; H.endAt = 0; H.winner = null; H.votes = {};
      sysAll('🏠 대기실로 돌아왔어요. 방장이 다시 시작할 수 있어요.');
      broadcastState();
      return;
    }
  }
}

function checkNightDone(){
  if (H.phase !== 'night') return;
  const alive = H.players.filter(q => q.alive);
  const need = ['mafia','doctor','police'].filter(r => alive.some(q => q.role === r));
  if (need.every(r => H.night[r])) { hurry(resolveNight); broadcastState(); }
}

function startDay(){
  H.votes = {};
  sysAll(`☀️ ${H.day}일차 낮이 밝았어요. 2분 동안 토론하며 마피아를 찾아보세요!`);
  setPhase('day', DUR.day, startVote);
}
function startVote(){
  if (H.phase !== 'day') return;
  H.votes = {};
  sysAll('🌆 저녁이 되었어요. 30초 안에 처형할 사람에게 투표하세요!');
  setPhase('vote', DUR.vote, resolveVote);
}
function resolveVote(){
  if (H.phase !== 'vote') return;
  clearTimeout(H.timer);
  const tally = {}, lines = [];
  for (const [v, t] of Object.entries(H.votes)) {
    const vp = P(v), tp = P(t);
    if (!vp || !vp.alive || !tp || !tp.alive) continue;
    tally[t] = (tally[t] || 0) + 1;
    lines.push(`${vp.name}→${tp.name}`);
  }
  sysAll('🗳️ 투표 내역: ' + (lines.length ? lines.join(', ') : '아무도 투표하지 않았어요.'));
  const max = Math.max(0, ...Object.values(tally));
  const top = Object.keys(tally).filter(t => tally[t] === max);
  if (max > 0 && top.length === 1) {
    const t = P(top[0]); t.alive = false;
    sysAll(`⚖️ ${t.name}님이 ${max}표로 처형되었어요.`);
    deliver(t.id, { type:'sys', kind:'private', text:'당신은 처형되었어요. 이제 죽은 사람끼리만 대화할 수 있어요.' });
  } else {
    sysAll(max > 0 ? '⚖️ 동점이라 아무도 처형되지 않았어요.' : '⚖️ 아무도 처형되지 않았어요.');
  }
  if (checkWin()) return;
  startNight();
}
function startNight(){
  H.night = { mafia:null, doctor:null, police:null };
  sysAll('🌙 밤이 되었어요. 마피아·의사·경찰은 대상을 선택하세요. (30초)');
  setPhase('night', DUR.night, resolveNight);
}
function resolveNight(){
  if (H.phase !== 'night') return;
  clearTimeout(H.timer);
  const t = P(H.night.mafia);
  if (t && t.alive) {
    if (H.night.doctor === t.id) sysAll('💉 의사가 마피아의 공격으로부터 누군가를 살려냈어요! 아무도 죽지 않았어요.');
    else {
      t.alive = false;
      sysAll(`☠️ 밤사이 ${t.name}님이 마피아에게 살해당했어요.`);
      deliver(t.id, { type:'sys', kind:'private', text:'당신은 살해당했어요. 이제 죽은 사람끼리만 대화할 수 있어요.' });
    }
  } else sysAll('🌙 조용한 밤이었어요. 아무 일도 일어나지 않았어요.');
  H.day++;
  if (checkWin()) return;
  startDay();
}
function checkWin(){
  const alive = H.players.filter(q => q.alive);
  const m = alive.filter(q => q.role === 'mafia').length, o = alive.length - m;
  let w = null;
  if (m === 0) w = 'citizen'; else if (m >= o) w = 'mafia';
  if (!w) return false;
  clearTimeout(H.timer);
  H.winner = w; H.phase = 'end'; H.endAt = 0;
  sysAll(w === 'mafia' ? '🔪 마피아 승리! 마피아가 마을을 장악했어요.' : '🎉 시민 승리! 마피아를 모두 찾아냈어요.');
  sysAll('📜 역할 공개: ' + H.players.map(q => `${q.name}(${ROLE[q.role].name})`).join(', '));
  broadcastState();
  return true;
}
function hostLeave(pid){
  delete conns[pid];
  const p = P(pid); if (!p || !p.online) return;
  if (!inGame()) {
    H.players = H.players.filter(q => q.id !== pid);
    sysAll(`${p.name}님이 나갔어요.`);
    broadcastState();
    return;
  }
  p.online = false;
  const wasAlive = p.alive;
  p.alive = false; delete H.votes[pid];
  sysAll(`🚪 ${p.name}님이 게임을 나갔어요${wasAlive ? ' (사망 처리)' : ''}.`);
  if (checkWin()) return;
  broadcastState();
  if (H.phase === 'vote' && H.players.filter(q => q.alive).every(q => H.votes[q.id])) hurry(resolveVote);
  if (H.phase === 'night') checkNightDone();
}

window.addEventListener('beforeunload', e => {
  if (isHost && S && S.phase !== 'lobby' && !leaving) { e.preventDefault(); e.returnValue = ''; }
});
</script>
</body>
